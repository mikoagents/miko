dist/

# Alchemy local cache and state
.alchemy/

tempdocs

# Environment variables
.env
# Account id only. Alchemy reads this during Workers Builds; real tokens stay in CI.
!apps/web/.env

# Logs
logs
*.log
npm-debug.log*

# Workspace directories
workspaces/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Test coverage
coverage/

